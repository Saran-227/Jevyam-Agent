# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Supabase (Phase 2)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
SUPABASE_IMAGE_BUCKET=post-images

# LinkedIn API (Phase 5 — Company Page Publishing)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_ORGANIZATION_ID=12345678
AUTO_PUBLISH_ON_APPROVAL=true
# Set LINKEDIN_MOCK_PUBLISHING=true for safe dry-run approval testing without publishing to LinkedIn
LINKEDIN_MOCK_PUBLISHING=false

# Application Configuration (Phase 6 Orchestration & Execution Mode)
APP_BASE_URL=http://localhost:8000
APP_ENV=development
DRY_RUN=true

# Approval Provider Selection (telegram or whatsapp)
APPROVAL_PROVIDER=telegram

# Telegram Bot Configuration (Phase 7 — Bot: JeevyamTechBOT @jeevyam_bot)
TELEGRAM_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_FOUNDER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Configuration (Phase 4 — Kept for backward compatibility)
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_FOUNDER_PHONE=+919876543210
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_API_VERSION=v21.0

